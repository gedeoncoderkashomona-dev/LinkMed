# ============================================================
# REGULA-ON — Variáveis de ambiente
# Copie para .env.local e ajuste os valores.
# ============================================================

# ----- Aplicação -----
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="Regula-On"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ----- Autenticação (JWT) -----
# Gere segredos fortes em produção: `openssl rand -base64 48`
JWT_ACCESS_SECRET="dev-access-secret-troque-em-producao-000000000000"
JWT_REFRESH_SECRET="dev-refresh-secret-troque-em-producao-000000000000"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Sessão por inatividade (minutos)
SESSION_IDLE_TIMEOUT_MINUTES=45

# ----- Banco de dados & Supabase Cloud -----
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# DATABASE_URL="postgresql://postgres.[ref]:[PASSWORD]@aws-1-ca-central-1.pooler.supabase.com:6543/postgres"

# ----- Redis (FASE FUTURA — jobs/filas) -----
# REDIS_URL="redis://localhost:6379"

# ----- Storage (FASE FUTURA) -----
# STORAGE_DRIVER="memory"   # memory | s3 | minio
# S3_ENDPOINT=""
# S3_REGION=""
# S3_BUCKET="regula-on"
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""

# ----- E-mail (FASE FUTURA) -----
# MAIL_DRIVER="console"   # console | sendgrid | smtp
# SENDGRID_API_KEY=""
# MAIL_FROM="no-reply@regulaon.local"

# ----- Upload -----
UPLOAD_MAX_SIZE_MB=20
UPLOAD_ALLOWED_MIME="application/pdf"